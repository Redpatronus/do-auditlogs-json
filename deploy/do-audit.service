[Unit]
Description=DigitalOcean audit log scraper

[Service]
Type=oneshot
User=doaudit
WorkingDirectory=/opt/do-auditlogs-json
EnvironmentFile=/opt/do-auditlogs-json/.env
# Headed Chromium on an automatic virtual display (needs: apt install xvfb)
ExecStart=/opt/do-auditlogs-json/.venv/bin/do-audit scrape
# Exit code 2 = session expired -> alert on this
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/do-auditlogs-json/data
