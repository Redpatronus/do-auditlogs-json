DOAL_STORAGE_STATE_PATH=data/storage_state.json
DOAL_OUTPUT_PATH=data/audit_logs.ndjson
DOAL_STATE_PATH=data/state.json
DOAL_HEADLESS=false
DOAL_MAX_PAGES=100
DOAL_LOG_LEVEL=INFO

# Page with the audit log. It depends on the type of the DigitalOcean account; use the one where
# the account shows the table of events (time, action, user, IP). Set exactly ONE of these.
# Account with lower permissions:
DOAL_AUDIT_PATH=/account/security
# Account with higher permissions (Security section in the left menu):
# DOAL_AUDIT_PATH=/settings/security
# (If unset, the built-in default /security/history is used; DO redirects it to the dashboard
#  for some accounts.)

# Server-side auto-login (chmod 600 this file!)
DOAL_EMAIL=
DOAL_PASSWORD=
DOAL_TOTP_SECRET=
# Reuse the cached login for this long (set ONE, keep <= DO's session lifetime; both empty = 7 days)
DOAL_SESSION_MAX_AGE_DAYS=7
DOAL_SESSION_MAX_AGE_HOURS=
